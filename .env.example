# JARVIS Environment Variables — Example
# Copy this file to .env and fill in your values.

# Required: Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Home Assistant (only needed if smart_home.enabled: true in config.yaml)
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your_long_lived_access_token_here

# Optional: override platform detection (set to "rpi" on Raspberry Pi)
# JARVIS_PLATFORM=rpi

# OpenClaw Configuration
# Gateway URL (default: http://127.0.0.1:18789)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_PORT=18789

# Fish Audio TTS (for voice synthesis)
FISH_API_KEY=your_fish_audio_api_key_here
FISH_VOICE_ID=your_voice_id_here
