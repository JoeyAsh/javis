# ==============================================================================
# JARVIS — Environment Variables (Example)
# Copy this file to .env and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core — required
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
FISH_API_KEY=your_fish_audio_api_key_here
FISH_VOICE_ID=your_voice_id_here

# ------------------------------------------------------------------------------
# ElevenLabs (Sound Effects Generation + optional TTS fallback)
# Create an API key at: https://elevenlabs.io/app/settings/api-keys
# Recommended scopes: Sound Effects (Access), Text to Speech (Access),
# Models (Access), User (Read). Set a monthly credit cap (e.g. 5000) as a
# safety net against key leakage.
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=
# ELEVENLABS_DEFAULT_VOICE_ID=     # optional — default voice for TTS if used
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2   # optional override

# ------------------------------------------------------------------------------
# Home Assistant (optional — only if smart_home.enabled in config.yaml)
# ------------------------------------------------------------------------------
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your_long_lived_access_token_here

# ------------------------------------------------------------------------------
# OpenClaw Gateway (defaults work for local install)
# ------------------------------------------------------------------------------
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_PORT=18789

# ------------------------------------------------------------------------------
# Google OAuth (Gmail + Calendar integration)
# Create Desktop-App OAuth client at:
#   https://console.cloud.google.com/apis/credentials
# Scopes: gmail.readonly, gmail.send, calendar
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8766/oauth/google/callback
# GOOGLE_TOKEN_CACHE=~/.jarvis/google_token.json

# ------------------------------------------------------------------------------
# Spotify (NowPlayingPanel + voice playback control)
# Create a Developer App at https://developer.spotify.com/dashboard
# PKCE flow — no client secret required. Spotify Premium required.
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8766/oauth/spotify/callback
# SPOTIFY_TOKEN_CACHE=~/.jarvis/spotify_token.json

# ------------------------------------------------------------------------------
# Govee LEDs (LightsPanel)
# Apply for API key in Govee mobile app:
#   Settings → About → Apply for API Key (arrives via email)
# ------------------------------------------------------------------------------
GOVEE_API_KEY=

# ------------------------------------------------------------------------------
# GitHub (DevPanel — PRs, issues, CI status)
# Fine-grained PAT from https://github.com/settings/tokens
# Scopes: repo (read), read:org, workflow (read)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# GitLab (work items integration)
# PAT from https://gitlab.com/-/user_settings/personal_access_tokens
# Scopes: api, read_repository
# ------------------------------------------------------------------------------
GITLAB_TOKEN=
# GITLAB_URL=https://gitlab.com

# ------------------------------------------------------------------------------
# Platform override (optional — auto-detected)
# ------------------------------------------------------------------------------
# JARVIS_PLATFORM=rpi

# ------------------------------------------------------------------------------
# Tailscale Remote Access (optional)
# When you run JARVIS as a multi-device service over Tailscale:
# - JARVIS_REMOTE_ACCESS=true flips api.host from 127.0.0.1 to 0.0.0.0 so the
#   backend listens on the tailnet interface as well as loopback. Tailscale
#   ACL is your auth boundary — there is no API-level token check yet.
# - TAILSCALE_HOSTNAME or `tailscale status --json` is auto-detected at
#   startup to populate mcp.advertise_host. Set explicitly only to override.
# - JARVIS_MCP_ADVERTISE_HOST is still the highest-priority override.
# ------------------------------------------------------------------------------
# JARVIS_REMOTE_ACCESS=true
# TAILSCALE_HOSTNAME=laptop-paps.tailnet.ts.net
# JARVIS_MCP_ADVERTISE_HOST=laptop-paps.tailnet.ts.net

# When OpenClaw runs on a different machine than JARVIS, update
# `openclaw.gateway_url` in config/config.yaml to use the OpenClaw host's
# tailnet address, e.g.:
#   gateway_url: "http://linux-laptop.tailnet.ts.net:18789"
# (config.yaml key — not an env var. Listed here for cross-reference.)
